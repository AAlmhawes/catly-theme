{% extends 'layouts.master' %}

{% block content %}
<div class="container">

  <nav class="breadcrumb" aria-label="{{ trans('general.breadcrumb') }}">
    <a href="{{ url('home') }}">{{ trans('general.home') }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ trans('blog.title') }}</span>
  </nav>

  <h1 class="page-title">{{ trans('blog.title') }}</h1>

  <div class="blog-grid">
    {% for post in posts.items %}
      <article class="blog-card">
        {% if post.image %}
          <a href="{{ post.url }}" class="blog-card__image-wrap">
            <img
              src="{{ post.image }}"
              alt="{{ post.title }}"
              width="400" height="250"
              loading="lazy"
              decoding="async"
            >
          </a>
        {% endif %}
        <div class="blog-card__body">
          <h2 class="blog-card__title">
            <a href="{{ post.url }}">{{ post.title }}</a>
          </h2>
          <p class="blog-card__excerpt">{{ post.excerpt | striptags | slice(0, 120) }}...</p>
          <a href="{{ post.url }}" class="btn btn--outline btn--sm">{{ trans('blog.read_more') }}</a>
        </div>
      </article>
    {% else %}
      <p class="empty-state">{{ trans('blog.no_posts') }}</p>
    {% endfor %}
  </div>

  {% component posts.pagination %}

</div>
{% endblock %}
