{% extends 'layouts.master' %}

{% block content %}
<div class="container">

  <nav class="breadcrumb" aria-label="{{ trans('general.breadcrumb') }}">
    <a href="{{ url('home') }}">{{ trans('general.home') }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ url('blog') }}">{{ trans('blog.title') }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ post.title }}</span>
  </nav>

  <article class="blog-single">
    {% if post.image %}
      <div class="blog-single__hero">
        <img
          src="{{ post.image }}"
          alt="{{ post.title }}"
          width="1200" height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </div>
    {% endif %}
    <div class="blog-single__content">
      <h1 class="blog-single__title">{{ post.title }}</h1>
      <div class="blog-single__body">{{ post.content | raw }}</div>
    </div>
  </article>

</div>
{% endblock %}
