{# ===== Footer Component ===== #}
<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">

      {# About column #}
      <div>
        <h3 class="site-footer__column-title">{{ store.name }}</h3>
        <p style="font-size: 13px; opacity: 0.8; margin: 0 0 16px;">
          {{ store.description | default(trans('home.hero_subtitle')) }}
        </p>
        {% if store.social %}
          <div style="display: flex; gap: 12px;" aria-label="{{ trans('footer.follow_us') }}">
            {% if store.social.instagram %}
              <a href="{{ store.social.instagram }}" aria-label="Instagram" rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {% endif %}
            {% if store.social.twitter %}
              <a href="{{ store.social.twitter }}" aria-label="Twitter" rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h3l-7 8 8 11h-6l-5-6-6 6H2l7-8L2 2h6l4 5z"/></svg>
              </a>
            {% endif %}
            {% if store.social.tiktok %}
              <a href="{{ store.social.tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 7.5a5 5 0 0 1-3-1v8.5a5.5 5.5 0 1 1-5.5-5.5h.5v3.5a2 2 0 1 0 2 2V2h3a5 5 0 0 0 3 5v.5z"/></svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {# Quick Links #}
      <div>
        <h3 class="site-footer__column-title">{{ trans('footer.quick_links') }}</h3>
        <ul class="site-footer__links">
          <li><a href="{{ url('about') }}">{{ trans('footer.about_us') }}</a></li>
          <li><a href="{{ url('products') }}">{{ trans('navigation.shop') }}</a></li>
          <li><a href="{{ url('blog') }}">{{ trans('navigation.blog') }}</a></li>
          <li><a href="{{ url('contact') }}">{{ trans('navigation.contact') }}</a></li>
        </ul>
      </div>

      {# Customer Service #}
      <div>
        <h3 class="site-footer__column-title">{{ trans('footer.customer_service') }}</h3>
        <ul class="site-footer__links">
          <li><a href="{{ url('shipping-policy') }}">{{ trans('footer.shipping_policy') }}</a></li>
          <li><a href="{{ url('return-policy') }}">{{ trans('footer.return_policy') }}</a></li>
          <li><a href="{{ url('privacy-policy') }}">{{ trans('footer.privacy_policy') }}</a></li>
          <li><a href="{{ url('terms') }}">{{ trans('footer.terms_conditions') }}</a></li>
        </ul>
      </div>

      {# Newsletter #}
      <div>
        <h3 class="site-footer__column-title">{{ trans('footer.newsletter_title') }}</h3>
        <p style="font-size: 13px; opacity: 0.8; margin: 0 0 12px;">
          {{ trans('footer.newsletter_description') }}
        </p>
        <form action="{{ url('newsletter-subscribe') }}" method="post" style="display: flex; gap: 8px;">
          <input
            type="email"
            name="email"
            placeholder="{{ trans('footer.email_placeholder') }}"
            required
            style="flex: 1; padding: 10px 14px; border-radius: var(--radius-pill); border: none; font-size: 13px; font-family: inherit;"
          >
          <button type="submit" class="btn btn--primary btn--small">
            {{ trans('footer.subscribe') }}
          </button>
        </form>
      </div>

    </div>

    <div class="site-footer__bottom">
      <p style="margin: 0;">
        © {{ "now" | date("Y") }} {{ store.name }}. {{ trans('footer.all_rights_reserved') }}
      </p>
    </div>
  </div>

  {% hook 'footer:end' %}
</footer>
